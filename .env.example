# Postgres local (pnpm db:start levanta uno en el puerto 54329 sin Docker)
PGPORT=54329
# En producción se usan URLs completas:
# DATABASE_URL=postgres://app_runtime:...@host/db          (runtime, sujeto a RLS)
# DATABASE_URL_MIGRATOR=postgres://owner:...@host/db       (solo migraciones)
APP_RUNTIME_PASSWORD=app_runtime_local

PORT=3000
API_BASE_URL=http://localhost:3000
WEB_ORIGINS=http://localhost:5173,http://localhost:4321
BETTER_AUTH_SECRET=cambia-esto-por-32-bytes-aleatorios
