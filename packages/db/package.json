{
  "name": "@salon/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:start": "tsx scripts/dev-db.ts",
    "migrate": "tsx scripts/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "@types/node": "22.18.0",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
