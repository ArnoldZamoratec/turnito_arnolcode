{
  "name": "@salon/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@salon/db": "workspace:*",
    "@salon/kernel": "workspace:*",
    "better-auth": "1.7.7",
    "fastify": "5.12.5",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
