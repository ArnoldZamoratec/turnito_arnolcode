{
  "name": "salon-saas",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:start": "corepack pnpm --filter @salon/db db:start",
    "db:migrate": "corepack pnpm --filter @salon/db migrate",
    "dev": "turbo run dev --parallel"
  },
  "devDependencies": {
    "turbo": "2.11.7",
    "typescript": "5.9.3"
  }
}
